# ==================== 必需配置 ====================

# 会话加密密钥（64字符随机字符串）
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHARACTERS

# 管理员密码（建议使用复杂密码）
ADMIN_PASSWORD=CHANGE_ME

# ==================== 数据库配置 ====================

# SQLite 数据库路径（Docker 环境使用绝对路径）
DATABASE_URL=sqlite:////data/pkm.db

# ==================== 网络配置 ====================

# 是否允许 HTTP（生产环境必须设为 false）
PKM_ALLOW_INSECURE_HTTP=true

# 测试模式：免配对同步（仅测试环境，生产必须设为 false）
PKM_TEST_PUBLIC_SYNC=false

# ==================== AI 配置（可选）====================

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 本地 Ollama（如果使用）
OLLAMA_BASE_URL=http://localhost:11434

# ==================== 备份配置 ====================

# 备份保留天数
BACKUP_KEEP_DAYS=7

# 备份时间（cron 表达式，默认每天凌晨 2 点 CST）
BACKUP_SCHEDULE=0 2 * * *

# ==================== 日志配置 ====================

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
